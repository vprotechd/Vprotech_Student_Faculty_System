PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Agora App Certificate is server-only; never add it to the Expo app.
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Gmail App Password (not your normal Gmail password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_gmail_app_password
EMAIL_SERVICE=gmail

# IMPORTANT: public URL of this backend, reachable from the student's phone (used for the tap-to-verify link in the email).
# Example: BACKEND_PUBLIC_URL=http://192.168.1.10:5000  or  https://api.yourdomain.com
# If empty, the URL of the request that registered the student is used.
BACKEND_PUBLIC_URL=https://vprotech-student-faculty-system1.onrender.com

# Optional: deployed Expo web URL. If omitted, the app deep link myapp://verify-email is used.
# Example: FRONTEND_URL=https://your-frontend-domain.com
FRONTEND_URL=https://vprotech-student-faculty-system2.onrender.com

# Existing optional project settings
CLIENT_ORIGINS=https://vprotech-student-faculty-system2.onrender.com,http://localhost:8081,http://localhost:19006,http://localhost:5173
ENABLE_TEST_ROUTES=false
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
